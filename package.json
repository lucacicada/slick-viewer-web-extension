{
  "name": "slick-viewer-web-extension",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "cross-env TARGET=firefox vite",
    "build": "vue-tsc && vite build",
    "build:chrome": "rimraf dist && rimraf dist-zip && cross-env TARGET=chrome vite build",
    "build:firefox": "rimraf dist && rimraf dist-zip && cross-env TARGET=firefox vite build",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@vueuse/core": "^13.4.0",
    "@vueuse/gesture": "^2.0.0",
    "lucide-vue-next": "^0.525.0",
    "vue": "^3.5.17",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-vue": "^4.6.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.30.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.6.3",
    "vite": "^5.4.19",
    "vite-plugin-web-extension": "^4.4.4",
    "vite-plugin-zip-pack": "^1.2.4",
    "vue-tsc": "^1.8.27",
    "webextension-polyfill": "^0.10.0"
  },
  "pnpm": {
    "neverBuiltDependencies": []
  }
}
