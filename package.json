    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vite-plugin-web-extension": "^4.4.5",
